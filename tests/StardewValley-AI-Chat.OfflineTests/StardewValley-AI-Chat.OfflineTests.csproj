<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\StardewValley-AI-Chat\AI\*.cs" Link="AI\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\StardewValley-AI-Chat\Dialogue\*.cs" Link="Dialogue\%(Filename)%(Extension)" />
    <None Include="..\..\src\StardewValley-AI-Chat\Data\Dialogues\*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\StardewValley-AI-Chat\ConfigTemplates\*.json" Link="ConfigTemplates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\src\StardewValley-AI-Chat\Data\NpcProfiles\Vanilla.json" LogicalName="StardewAI.VanillaNpcProfiles.json" />
  </ItemGroup>
</Project>
